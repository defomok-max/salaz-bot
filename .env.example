# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Serper.dev API key (get at https://serper.dev).
# For automatic rotation when one key is exhausted, supply several
# comma-separated keys via SERPER_API_KEYS instead (or in addition to).
# WARNING: do NOT commit real keys to git. Use a local .env file that is
# listed in .gitignore.
SERPER_API_KEY=
SERPER_API_KEYS=

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# REQUIRED on first deploy: comma-separated Telegram IDs / @usernames (no @)
# that get auto-promoted to admin on first /start. The bot WILL NOT auto-
# promote any user without this set (intentional — see RENDER.md). Find
# your Telegram ID via @userinfobot.
ADMIN_USER_IDS=
ADMIN_USERNAMES=

# Optional overrides
MAX_RESULTS=50
# Serper.dev free tier caps `num` at ~10 (HTTP 400 "Query pattern not allowed" above).
RESULTS_PER_QUERY=10
MAX_SEARCH_CALLS=15
SEARCH_TIMEOUT_SECONDS=20
# Max concurrent oEmbed / verification HTTP calls per pipeline run.
VERIFICATION_CONCURRENCY=8
LOG_LEVEL=INFO

# History persistence
HISTORY_DB_PATH=history.db
HISTORY_PER_PAGE=10
RESULTS_PER_PAGE=10
